<template>
  <div class="page">
    <!-- 视图：主菜单 -->
    <div if="{{view === 'menu'}}" class="view">
      <image src="/common/logo.png" class="logo" alt="blank" />
      <text class="title">小丑牌</text>
      <text class="subtitle">腕上构筑 · 扑克肉鸽</text>
      <input class="btn btn-primary" type="button" value="开始游戏" onclick="startGame" />
      <input class="btn btn-plain" type="button" value="玩法规则" onclick="goRules" />
      <text class="best-text">最高分 {{bestScore}}</text>
    </div>

    <!-- 视图：对局 -->
    <div if="{{view === 'game'}}" class="view">
      <div class="info-row">
        <text class="info-text">盲注 {{round}}</text>
        <text class="info-text">出牌 {{handsLeft}}</text>
        <text class="info-text">弃牌 {{discardsLeft}}</text>
      </div>
      <div class="score-row">
        <text class="score-big">{{roundScore}}</text>
        <text class="score-target">/ {{target}}</text>
      </div>
      <progress type="horizontal" percent="{{progressPercent}}" class="progress-bar"></progress>
      <div class="preview-row">
        <text class="preview-name">{{handName}}</text>
        <text class="preview-math">{{handChipText}} × {{handMultText}}</text>
      </div>
      <div class="joker-row">
        <div for="{{jokers}}" tid="id" class="joker-slot">
          <image src="{{$item.icon}}" class="joker-icon" alt="blank" />
        </div>
        <text if="{{jokers.length === 0}}" class="joker-empty">尚未拥有小丑牌</text>
      </div>
      <div class="hand-row">
        <div for="{{hand}}" tid="id" class="hand-slot" onclick="toggleCard($item)">
          <image if="{{$item.selected}}" src="{{$item.img}}" class="card-img card-img-on" alt="blank" />
          <image if="{{!$item.selected}}" src="{{$item.img}}" class="card-img" alt="blank" />
        </div>
      </div>
      <div class="btn-row">
        <input class="btn btn-play" type="button" value="出牌" onclick="playHand" />
        <input class="btn btn-discard" type="button" value="弃牌" onclick="discardCards" />
      </div>
    </div>

    <!-- 视图：小丑三选一 -->
    <div if="{{view === 'reward'}}" class="view">
      <text class="title-s">盲注突破！</text>
      <text class="subtitle">选择一张小丑牌</text>
      <div for="{{rewardChoices}}" tid="id" class="choice-item" onclick="pickJoker($item)">
        <div class="choice-thumb">
          <image src="{{$item.icon}}" class="choice-icon" alt="blank" />
        </div>
        <div class="choice-text">
          <text class="choice-name">{{$item.name}}</text>
          <text class="choice-desc">{{$item.desc}}</text>
        </div>
      </div>
    </div>

    <!-- 视图：结算 -->
    <div if="{{view === 'over'}}" class="view">
      <text class="title-s">游戏结束</text>
      <text class="over-score">{{totalScore}}</text>
      <text class="over-info">到达盲注 {{overRound}}　最高分 {{bestScore}}</text>
      <input class="btn btn-primary" type="button" value="再来一局" onclick="startGame" />
      <input class="btn btn-plain" type="button" value="返回菜单" onclick="backToMenu" />
    </div>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000000;
}

.view {
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.logo {
  width: 120px;
  height: 120px;
  margin-bottom: 12px;
  border-radius: 38px;
}

.title {
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}

.title-s {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}

.subtitle {
  font-size: 20px;
  color: #d8d8d8;
  margin-top: 6px;
  margin-bottom: 18px;
}

.best-text {
  font-size: 20px;
  color: #d8d8d8;
  margin-top: 16px;
}

.btn {
  width: 280px;
  height: 60px;
  margin-top: 10px;
  border-radius: 33px;
  background-color: #262626;
  font-size: 22px;
  color: #ffffff;
  text-align: center;
}

.btn-primary {
  background-color: #0d6eff;
  color: #ffffff;
  font-weight: bold;
}

.btn-plain {
  background-color: #262626;
  color: #d8d8d8;
}

.info-row {
  flex-direction: row;
  justify-content: space-between;
  width: 360px;
}

.info-text {
  font-size: 20px;
  color: #d8d8d8;
}

.score-row {
  flex-direction: row;
  align-items: baseline;
  margin-top: 2px;
}

.score-big {
  font-size: 52px;
  font-weight: bold;
  color: #ffffff;
}

.score-target {
  font-size: 22px;
  color: #d8d8d8;
  margin-left: 8px;
}

.progress-bar {
  width: 320px;
  height: 6px;
  margin-top: 6px;
  border-radius: 3px;
}

.preview-row {
  flex-direction: column;
  align-items: center;
  margin-top: 8px;
}

.preview-name {
  font-size: 24px;
  font-weight: bold;
  color: #19ce79;
}

.preview-math {
  font-size: 18px;
  color: #d8d8d8;
}

.joker-row {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 6px;
  height: 64px;
}

.joker-slot {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 64px;
  height: 64px;
  margin-left: 4px;
  margin-right: 4px;
  border-radius: 20px;
  background-color: rgba(255, 255, 255, 0.06);
}

